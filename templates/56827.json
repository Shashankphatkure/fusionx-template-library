full", "flex_gap": {"column": "30", "row": "30", "isLinked": true, "unit": "px", "size": 30}, "container_sticky_offset": 50}, "elements": [{"id": "f3ede0e", "elType": "widget", "settings": {"text": "<h4>Explore an unlimited galaxy</h4><p>Los Angeles is in quarantine and the military have retreated. Only you, and the handful of others who happen to be resistant to the pathogen, holds the future of the city (and humanity), in the balance.<br />Dead Island 2 is stylish, vibrant and flooded with zombie infection. Explore iconic, gore-drenched Los Angeles. Meet larger-than-life characters. Slay countless foes in exquisitely bloody detail. And evolve to become the ultimate Zombie Slayer! Pre-purchase now and get the Memories of Banoi pack.</p>", "scroll_y": -80}, "elements": [], "widgetType": "wd_text_block"}, {"id": "31169ee", "elType": "widget", "settings": {"video_type": "vimeo", "video_youtube_url": "https://www.youtube.com/watch?v=XHOmBV4js_E", "video_vimeo_url": "https://vimeo.com/235215203", "video_action_button": "overlay", "video_image_overlay": {"url": "{{LIB}}/media/dummy.xtemos.com/woodmart2/games-elementor/wp-content/uploads/sites/16/2023/07/wd-vgs-sw-j-video-thumbnail-1-opt.jpg", "id": 1303, "size": "", "alt": "", "source": "library"}, "video_image_overlay_custom_dimension": {"width": "735", "height": "441"}, "text": "Play video", "video_height": {"unit": "px", "size": 430, "sizes": []}, "play_button_icon_size": {"unit": "px", "size": 79, "sizes": []}, "_element_custom_width": {"unit": "px", "size": 260, "sizes": []}, "scroll_y": -80}, "elements": [], "widgetType": "wd_video"}], "isInner": true}, {"id": "c4e8c00", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 50, "sizes": []}, "width_tablet": {"unit": "%", "size": 100, "sizes": []}, "width_mobile": {"unit": "%", "size": "", "sizes": []}, "flex_direction": "row", "flex_direction_mobile": "column", "flex_gap": {"column": "30", "row": "30", "isLinked": true, "unit":